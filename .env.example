# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=change_this_to_secure_root_password
MYSQL_PASSWORD=change_this_to_secure_kami_password

# ==================== Redis 配置 ====================
REDIS_PASSWORD=change_this_to_secure_redis_password

# ==================== JWT 配置 ====================
# 生成方式: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_256_BIT_KEY

# ==================== 加密配置 ====================
# 用于 API 密钥加密，生成方式: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_AES_256_KEY

# ==================== 邮件配置 ====================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_email_password_here

# ==================== 应用配置 ====================
APP_DOMAIN=yourdomain.com
APP_BASE_URL=https://yourdomain.com

# ==================== 安全配置 ====================
# 管理员初始密码（首次启动后立即修改）
ADMIN_INITIAL_PASSWORD=Admin@123456

# CORS 允许的源
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==================== 备份配置 ====================
# OSS/S3 配置（可选）
BACKUP_OSS_ENDPOINT=
BACKUP_OSS_ACCESS_KEY=
BACKUP_OSS_SECRET_KEY=
BACKUP_OSS_BUCKET=

# ==================== 监控配置 ====================
# Webhook 告警地址（可选）
ALERT_WEBHOOK_URL=

# ==================== 生产环境重要提示 ====================
# 1. 所有带 "CHANGE_THIS" 的值必须修改
# 2. 所有密码必须使用强密码（至少16位，包含大小写字母、数字、特殊字符）
# 3. JWT_SECRET 和 ENCRYPTION_KEY 必须是高强度随机值
# 4. 定期轮换密钥
# 5. 不要将 .env 文件提交到版本控制
